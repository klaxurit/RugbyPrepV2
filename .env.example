# ============================================
# RugbyPrep — Variables d'environnement client (Vite)
# Copier vers .env.local et renseigner les valeurs
# ============================================

# Supabase — Projet et clé publique
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_remplace_par_ta_cle_anon
# Optionnel: alias pour anon key (compatibilité)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push (VAPID) — clé publique uniquement
# Générer: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=REMPLACE_PAR_TA_CLE_PUBLIQUE_VAPID

# PostHog Analytics — clé projet (région EU)
# Dashboard: https://app.posthog.com
VITE_POSTHOG_KEY=

# Sentry (optionnel — erreurs front uniquement si DSN défini)
# Dashboard: https://sentry.io
VITE_SENTRY_DSN=

# E2E Playwright (optionnel — uniquement pour `npm run test:e2e` en local ; ne partent PAS dans le bundle)
# Copier vers .env.local (non commité) : credentials compte Supabase staging, email confirmé.
E2E_TEST_EMAIL=reviewer@example.com
E2E_TEST_PASSWORD=change-me

# hCaptcha — site key publique (couplée au secret côté Supabase Auth)
# Dashboard: https://dashboard.hcaptcha.com (free tier Publisher)
# Doit matcher le secret configuré dans Supabase → Auth → Attack Protection
# Si non défini : aucun captcha rendu (dev / preview seulement).
VITE_HCAPTCHA_SITEKEY=

# ============================================
# Supabase Edge Functions (configurer via Supabase secrets)
# Ces variables ne vont pas dans .env.local
# Dashboard: Supabase > Project Settings > Edge Functions > Secrets
# Ou CLI : supabase secrets set SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# ============================================
# Sentry Edge (optionnel — erreurs fonctions Edge si DSN défini ; front reste sur VITE_SENTRY_DSN)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
# STRIPE_PRICE_PREMIUM_YEARLY=price_xxx
# STRIPE_PRICE_FOUNDING_YEARLY=price_xxx
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# ANTHROPIC_API_KEY=sk-ant-xxx
