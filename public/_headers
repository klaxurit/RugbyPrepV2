/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://play.google.com"), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://eu.i.posthog.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://eu.i.posthog.com https://eu-assets.i.posthog.com https://www.googleapis.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Routes privées (login/app authentifié) : noindex côté HTTP
# Indispensable car le SPA sert index.html avec robots: index,follow par défaut.
/auth/*
  X-Robots-Tag: noindex, follow

/login
  X-Robots-Tag: noindex, follow

/signup
  X-Robots-Tag: noindex, follow

/home
  X-Robots-Tag: noindex, follow

/onboarding
  X-Robots-Tag: noindex, follow

/profile
  X-Robots-Tag: noindex, follow

/week
  X-Robots-Tag: noindex, follow

/history
  X-Robots-Tag: noindex, follow

/progress
  X-Robots-Tag: noindex, follow

/program
  X-Robots-Tag: noindex, follow

/calendar
  X-Robots-Tag: noindex, follow

/session/*
  X-Robots-Tag: noindex, follow

/mobility
  X-Robots-Tag: noindex, follow

/chat
  X-Robots-Tag: noindex, follow

/staff-sandbox
  X-Robots-Tag: noindex, follow

/delete-account
  X-Robots-Tag: noindex, follow

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/og-rugbyforge.png
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
